{
    "name": "warhammer-schedule-bot",
    "version": "0.1.0",
    "description": "discord bot to manage scheduling for fantasy roleplay",
    "main": "index.js",
    "scripts": {
        "build_": "tsc --outDir './build'",
        "start": "ts-node index.js | pino-pretty",
        "test": "npm run test:dropdb && npm run database:init:test && DATABASE_URL='postgresql://root:password@localhost:5432/gm_sidekick' jest --forceExit",
        "test:dropdb": "rm prisma/dev.test.db || echo 'no database to drop'",
        "database:init": "prisma migrate dev --name init && prisma generate",
        "database:init:test": "DATABASE_URL='postgresql://root:password@localhost:5432/gm_sidekick' npm run database:init",
        "deploy-commands": "ts-node src/scripts/register-commands.ts",
        "invite-link": "ts-node src/scripts/invite.ts",
        "prettier": "npx prettier -w ."
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/TheIthorian/warhammer-schedule-bot.git"
    },
    "keywords": [
        "config",
        "js"
    ],
    "author": "TheIthorian",
    "bugs": {
        "url": "https://github.com/TheIthorian/warhammer-schedule-bot/issues"
    },
    "homepage": "https://github.com/TheIthorian/warhammer-schedule-bot#readme",
    "devDependencies": {
        "@faker-js/faker": "^8.3.1",
        "@types/jest": "^29.5.8",
        "@types/node": "^18.11.18",
        "@types/pg": "^8.15.6",
        "@types/prettier": "^2.7.2",
        "eslint": "^8.30.0",
        "eslint-config-next": "13.1.6",
        "jest": "^29.7.0",
        "prettier": "^2.8.1",
        "prisma": "6.19.0",
        "ts-jest": "^29.1.1",
        "typescript": "^5.2.2"
    },
    "dependencies": {
        "@babel/core": "^7.23.3",
        "@babel/preset-env": "^7.23.3",
        "@prisma/adapter-pg": "6.19.0",
        "@prisma/client": "6.19.0",
        "@types/moment": "^2.13.0",
        "@types/node-schedule": "^2.1.3",
        "@types/pino": "^7.0.5",
        "babel": "^6.23.0",
        "babel-jest": "^29.7.0",
        "discord.js": "^14.14.1",
        "dotenv": "^16.3.1",
        "moment": "^2.29.4",
        "node-schedule": "^2.1.1",
        "pino": "^8.16.2",
        "pino-pretty": "^10.2.3",
        "ts-node": "^10.9.1",
        "tsc": "^2.0.4"
    }
}
