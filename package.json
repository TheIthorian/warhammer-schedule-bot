{
    "name": "warhammer-schedule-bot",
    "version": "0.1.0",
    "description": "discord bot to manage scheduling for fantasy roleplay",
    "keywords": [
        "config",
        "js"
    ],
    "homepage": "https://github.com/TheIthorian/warhammer-schedule-bot#readme",
    "bugs": {
        "url": "https://github.com/TheIthorian/warhammer-schedule-bot/issues"
    },
    "license": "PolyForm-Noncommercial-1.0.0",
    "author": "TheIthorian",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/TheIthorian/warhammer-schedule-bot.git"
    },
    "main": "index.js",
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "start": "node dist/index.js",
        "dev": "tsx watch index.js | pino-pretty",
        "test": "vitest run",
        "lint": "oxlint .",
        "format": "oxfmt --config .oxfmtrc.json .",
        "db:migrate": "prisma migrate dev",
        "db:deploy": "prisma migrate deploy",
        "db:generate": "prisma generate",
        "deploy-commands": "tsx src/scripts/register-commands.ts",
        "invite-link": "tsx src/scripts/invite.ts"
    },
    "dependencies": {
        "@prisma/adapter-pg": "6.19.3",
        "@prisma/client": "6.19.3",
        "discord.js": "14.27.0",
        "dotenv": "17.4.2",
        "moment": "2.30.1",
        "moment-timezone": "^0.6.3",
        "node-schedule": "2.1.1",
        "pg": "8.22.0",
        "pino": "10.3.1",
        "pino-pretty": "13.1.3",
        "prisma": "6.19.3"
    },
    "devDependencies": {
        "@faker-js/faker": "10.5.0",
        "@types/node": "24.13.3",
        "@types/node-schedule": "2.1.3",
        "@types/pg": "8.15.6",
        "oxfmt": "0.59.0",
        "oxlint": "1.74.0",
        "tsx": "4.23.1",
        "typescript": "6.0.3",
        "vitest": "4.1.10"
    },
    "engines": {
        "node": ">=24.0.0",
        "pnpm": ">=9.0.0"
    },
    "packageManager": "pnpm@11.1.3"
}
