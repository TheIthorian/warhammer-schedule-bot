# src/config.ts swaps DATABASE_URL for TEST_DATABASE_URL when NODE_ENV=test,
# so both must point at the local test database.
DATABASE_URL="postgresql://root:password@localhost:5432/gm_sidekick?schema=public"
TEST_DATABASE_URL="postgresql://root:password@localhost:5432/gm_sidekick?schema=public"
NODE_ENV=test

# config.ts asserts these are present. Dummy values - the tests never call Discord.
APPLICATION_ID=test-application-id
PUBLIC_KEY=test-public-key
BOT_TOKEN=test-bot-token
CLIENT_ID=test-client-id
CLIENT_SECRET=test-client-secret
